# Deterministic installs
package-lock=true
save-exact=true
prefer-offline=false
prefer-online=true

# Allow build scripts when needed
ignore-scripts=false

# Ensure binaries are linked correctly
bin-links=true

# Security & registry
strict-ssl=true
registry=https://registry.npmjs.org/
audit=true

# Dependency behavior
optional=false
legacy-peer-deps=true
fund=false

# Allow Git dependencies
allow-git=all

# Prevent npm from modifying node_modules unexpectedly
update-notifier=false
engine-strict=true

# Improve reproducibility in monorepos / CI
lockfile-version=3
