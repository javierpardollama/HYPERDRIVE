        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <NuGetAuditMode>direct</NuGetAuditMode>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
        <UseAppHost>false</UseAppHost>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>e9196cd5-6407-4e22-b5b0-afd5daf98089</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        
      <ProjectReference Include="..\Hyperdrive.Gateway.Application\Hyperdrive.Gateway.Application.csproj" />
      <ProjectReference Include="..\Hyperdrive.Gateway.Infrastructure\Hyperdrive.Gateway.Infrastructure.csproj" />
    </ItemGroup>

</Project>
