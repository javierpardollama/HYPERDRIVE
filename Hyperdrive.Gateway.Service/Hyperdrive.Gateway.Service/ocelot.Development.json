{
  "$schema": "https://json.schemastore.org/ocelot.json",
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hyperdrive-identity-service",
          "Port": 8070
        }
      ],
      "UpstreamPathTemplate": "/api/identity/{everything}",
      "UpstreamHttpMethod": [
        "POST",
        "PUT",
        "GET",
        "DELETE",
        "OPTIONS"
      ],
      "QoSOptions": {
        "MinimumThroughput": 3,
        "BreakDuration": 30,
        "Timeout": 10000
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hyperdrive-storage-service",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/storage/{everything}",
      "UpstreamHttpMethod": [
        "POST",
        "PUT",
        "GET",
        "DELETE",
        "OPTIONS"
      ],
      "QoSOptions": {
        "MinimumThroughput": 3,
        "BreakDuration": 30,
        "Timeout": 10000
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:8061"
  }
}